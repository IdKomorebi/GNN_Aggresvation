  roles [shape=plain, label=<
   <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#8a8984" BGCOLOR="#ffffff">
    <TR><TD BGCOLOR="#efeeea"><B>接收方角色</B></TD><TD BGCOLOR="#efeeea"><B>公开基底 B（默认已知）</B></TD><TD BGCOLOR="#efeeea"><B>背景池 H（可再拿 ≤K 个）</B></TD></TR>
