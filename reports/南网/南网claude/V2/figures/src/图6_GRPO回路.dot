digraph G {
  graph [rankdir=LR, fontname="Noto Sans CJK SC", bgcolor="#fcfcfb", pad=0.3, nodesep=0.35, ranksep=0.55,
         label="图6  改造后的 GRPO 定级回路：状态随动作变化，才是真正的序列决策。灰虚线框为硬约束（不进奖励）",
         labelloc=b, labeljust=l, fontsize=12.5];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=10.5, penwidth=1.3, margin="0.13,0.07"];
  edge [color="#52514e", arrowsize=0.7, fontname="Noto Sans CJK SC", fontsize=9.5, fontcolor="#52514e"];
  s [label="状态 sₜ\n每个字段：当前等级、规则等级、M⁽⁰⁾、M⁽ᴷ⁾、Γ⁽ᴷ⁾、\n所涉最高目标级别、上调代价、是否锁定\n全局：各角色剩余越线组合数", fillcolor="#d3f0e4", color="#1baf7a"];
  a [label="动作 aₜ\n从可行动作中采样一组候选：\n“把字段 i 上调一级”或“结束”", fillcolor="#fbe1d6", color="#eb6834"];
  e [label="环境\n更新可见范围与各角色背景池\n通用模型重算受影响组合的 V 与 M⁽ᴷ⁾（毫秒级/组合）", fillcolor="#d3f0e4", color="#1baf7a"];
  r [label="奖励 rₜ\n＋越线风险的减少量（按目标级别加权）\n−该字段上调一级的可用性代价\n终止时：一致则奖励，否则重罚", fillcolor="#fbe1d6", color="#eb6834"];
  u [label="策略更新\n组内相对优势 (r−μ)/(σ+ε)\n+ KL 约束 + 熵正则（沿用师兄算法）", fillcolor="#fbe1d6", color="#eb6834"];
  c [label="硬约束（动作掩码）\n等级 ≥ 规则等级；法定公开字段不可调\n算法上调上限 3 级，涉及 4、5 级目标只出申报建议\n上调不超过所涉目标的级别", style="rounded,filled,dashed", fillcolor="#efeeea", color="#8a8984"];
  s -> a -> e -> r -> u; e -> s [label="sₜ₊₁", constraint=false]; u -> a [style=dashed, constraint=false, label="πθ"]; c -> a [style=dashed];
}
