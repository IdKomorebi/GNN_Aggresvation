digraph G {
  graph [rankdir=TB, fontname="Noto Sans CJK SC", bgcolor="#fcfcfb", nodesep=0.3, ranksep=0.42, pad=0.3, newrank=true,
         label="图2  面向南网的分类分级体系总图（四个阶段）。右侧为每一步对应的南网条款\n蓝＝南网规则与流程   灰＝师兄论文方法（保留）   橙＝师兄 GRPO（改造后）   绿＝近期研究",
         labelloc=b, labeljust=l, fontsize=12.5];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=10.5, penwidth=1.3, margin="0.13,0.07"];
  edge [color="#52514e", arrowsize=0.7, fontname="Noto Sans CJK SC", fontsize=9.5, fontcolor="#52514e"];

  subgraph cluster_1 { label="阶段一  基础分类分级"; fontsize=12; style="rounded,dashed"; color="#2a78d6"; fontcolor="#1c5cab";
    n11 [label="1.1 规则库：大模型+检索增强解析\n分级手册、风险手册、开放目录说明、披露与注册细则", fillcolor="#efeeea", color="#8a8984"];
    n12 [label="1.2 资产梳理与分类\n专业域→流程组→操作级流程→业务对象→字段；副本合并", fillcolor="#dbe8f9", color="#2a78d6"];
    n13 [label="1.3 规则定级 L_rule（1~5级）\n8要素→影响对象→影响程度→矩阵，就高不就低", fillcolor="#dbe8f9", color="#2a78d6"];
    n14 [label="1.4 场景标注\n披露层级、披露时点、是否法定公开、是否敏感目标", fillcolor="#dbe8f9", color="#2a78d6"];
    n11 -> n12 -> n13; n12 -> n14;
  }
  subgraph cluster_2 { label="阶段二  推断风险识别"; fontsize=12; style="rounded,dashed"; color="#1baf7a"; fontcolor="#0f7a53";
    n21 [label="2.1 场景实例化\n角色 r 的公开基底 B、背景池 H、预算 K=2；目标泄露线 τ_y", fillcolor="#d3f0e4", color="#1baf7a"];
    n22 [label="2.2 风险关联图（并联）\nPearson/Spearman/MIC；解释、先验、副本提示", fillcolor="#efeeea", color="#8a8984"];
    n23 [label="2.3 集合推断能力 V(S)\n通用模型扫描全部 ≤K+1 组合；DNN/GAT 为单字段、结构目标特例", fillcolor="#d3f0e4", color="#1baf7a"];
    n24 [label="2.4 字段级风险\nM⁽⁰⁾（单独）、M⁽ᴷ⁾（最坏背景）、Γ⁽ᴷ⁾（背景放大）、见证背景、可达精度", fillcolor="#d3f0e4", color="#1baf7a"];
    n25 [label="2.5 重训认证\n最强攻击者族、全量数据，认证高风险项", fillcolor="#d3f0e4", color="#1baf7a"];
    n21 -> n23 -> n24 -> n25; n22 -> n23 [style=dashed];
  }
  subgraph cluster_3 { label="阶段三  等级复核与优化"; fontsize=12; style="rounded,dashed"; color="#eb6834"; fontcolor="#b44a1f";
    n31 [label="3.1 一致性检查\n任何角色凭其可见字段中 ≤K+1 个的组合，\n都不能把高于其权限的目标推断到泄露线以上", fillcolor="#d3f0e4", color="#1baf7a"];
    n32 [label="3.2 等级优化（GRPO；基线：全部上调、贪心）\n动作：上调某字段一级 → 可见范围收窄 → 背景池变化 → 风险重算\n约束：≥L_rule；法定公开字段锁定；4、5级只出申报建议\n目标：一致的前提下上调最少", fillcolor="#fbe1d6", color="#eb6834"];
    n33 [label="3.3 建议等级 L_suggest + 推断证据\n证据写入“深度”要素与影响程度，按矩阵复核", fillcolor="#dbe8f9", color="#2a78d6"];
    n31 -> n32 -> n33; n32 -> n31 [style=dashed, label="重算"];
  }
  subgraph cluster_4 { label="阶段四  审批、固化与动态复评"; fontsize=12; style="rounded,dashed"; color="#2a78d6"; fontcolor="#1c5cab";
    n41 [label="4.1 审批 → 固化到数据目录\n新增列：规则等级、建议等级、上调原因、见证背景、适用角色与时点", fillcolor="#dbe8f9", color="#2a78d6"];
    n42 [label="4.2 事件触发复评\n附录E 七类场景 + 新批次开放、披露时点到达、细则修订、历史数据增长\n从当前等级出发增量重算", fillcolor="#dbe8f9", color="#2a78d6"];
    n41 -> n42;
  }
  n13 -> n21 [label="L_rule、目标级别"]; n14 -> n21; n25 -> n31; n13 -> n32 [label="下限", constraint=false]; n33 -> n41;
  n42 -> n21 [style=dashed, constraint=false, label="复评"];

  node [shape=note, fillcolor="#ffffff", color="#b8b7b1", fontsize=9.5];
  r1 [label="分级手册 四(一)(二)(三)、附录A–C\n开放目录说明 二(三)\n披露细则 5.1、2.7"];
  r2 [label="分级手册 分级要素“深度”、附录D、附录E-2\n风险手册 第382、330、351、239项\n披露细则 5.2–5.7（谁可见什么）"];
  r3 [label="分级手册 分级原则“从严性”“合理性”\n表4.1–4.4 各级共享开放口径\n重要/核心数据须认定"];
  r4 [label="分级手册 四(四)(五)(七)、附录E\n风险手册 第138、146、154项"];
  n14 -> r1 [style=dotted, arrowhead=none, constraint=false]; n24 -> r2 [style=dotted, arrowhead=none, constraint=false];
  n32 -> r3 [style=dotted, arrowhead=none, constraint=false]; n42 -> r4 [style=dotted, arrowhead=none, constraint=false];
  {rank=same; n14; r1} {rank=same; n24; r2} {rank=same; n32; r3} {rank=same; n42; r4}
}
