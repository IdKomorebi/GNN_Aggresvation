digraph G {
  graph [rankdir=LR, fontname="Noto Sans CJK SC", bgcolor="#fcfcfb", nodesep=0.28, ranksep=0.7, pad=0.25,
         label="(b) 以组合为单位（近期研究）：绿框=见证组合；字段框内为 M⁽⁰⁾→M⁽²⁾", labelloc=t, labeljust=l, fontsize=13, fontcolor="#0f7a53"];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=11, penwidth=1.3, margin="0.12,0.06"];
  edge [arrowsize=0.7, color="#1baf7a"];
  rp1 [label="本节点电价  0 → 0.150", fillcolor="#dbe8f9", color="#2a78d6"];
  rpg [label="机组出力 P_g  0.065 → 0.215", fillcolor="#fbe1d6", color="#eb6834"];
  rp2 [label="邻近节点电价  0 → 0.141", fillcolor="#dbe8f9", color="#2a78d6"];
  rp3 [label="阻塞线路后的电价  0 → 0.099\n（该线路阻塞时几乎失效）", fillcolor="#dbe8f9", color="#2a78d6"];
  h1 [label="{P_g, 本节点电价}", shape=box, style="filled", fillcolor="#1baf7a", color="#1baf7a", fontcolor="#ffffff", fontsize=10];
  h2 [label="{P_g, 邻近电价}", shape=box, style="filled", fillcolor="#1baf7a", color="#1baf7a", fontcolor="#ffffff", fontsize=10];
  h3 [label="{P_g, 远端电价}", shape=box, style="filled", fillcolor="#1baf7a", color="#1baf7a", fontcolor="#ffffff", fontsize=10];
  rk [label="目标：报价加成 κ", fillcolor="#efeeea", color="#8a8984"];
  rp1 -> h1 [arrowhead=none, penwidth=2]; rpg -> h1 [arrowhead=none, penwidth=2];
  rpg -> h2 [arrowhead=none, penwidth=1.5]; rp2 -> h2 [arrowhead=none, penwidth=1.5];
  rpg -> h3 [arrowhead=none, penwidth=1.1]; rp3 -> h3 [arrowhead=none, penwidth=1.1];
  h1 -> rk [penwidth=2]; h2 -> rk [penwidth=1.5]; h3 -> rk [penwidth=1.1];
}
